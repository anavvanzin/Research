# ~/Documents/projetos/research/ is a meta-workspace, not a monorepo.
# Sub-repos have their own .git and MUST NOT be nested-tracked here.
# This repo only versions workspace-level meta files: README, CLAUDE.md, docs/, cowork/.

# --- Ignore bucket dirs (populated or not) ---
/hub/
/labs/

# --- Untracked research material (PDFs, admin docs, legacy outputs) ---
/rotinas/
/dashboard.html

# --- Also ignore typical noise ---
.DS_Store
*.swp
*.swo
.remember/
**/.DS_Store
**/node_modules/
**/__pycache__/
**/.venv/
**/*.pyc
**/.pytest_cache/
**/*.log

# Repo-local self-improving-agent runtime state
/.claude/self-improving-agent/memory/episodic/**/*.json
/.claude/self-improving-agent/memory/working/*.json
!/.claude/self-improving-agent/memory/episodic/.gitkeep
!/.claude/self-improving-agent/memory/working/.gitkeep

# Session dumps (Hermes conversation exports)
/hermes_conversation_*.json
**/hermes_conversation_*.json
/hermes-agent/

# Git worktrees
/.worktrees/
/.claude/worktrees/
/Research/
.claude/settings.json

# OpenCode superpowers cache
.superpowers/

# --- Untracked sub-repos at root (own .git, not part of meta-workspace) ---
/agency-agents/
/agent-personal/
/agent-thesis/
/alignment-for-honesty/
/deep-memory/
/hermes-agent-camel/
/hermes-agent-*.bak-*/
/hermes-workspace/
/ml-intern/
/openclaw/
/united-by-marriage/

# --- Untracked symlinks to bucket sub-repos (resolved via parent dirs) ---
/iconocracia-companion
/iconocracy-corpus

# --- Sibling dirs (own .git or local, not tracked) ---
/capture/
/scripts/
/Do/
/Iconocracia/
/Ideas/
/Imported/
/LLM Skills/
/Other/
/Paths/
/Specs/
/Text/
/Tools/

# --- Stray root files ---
/Symlink - com~apple~CloudDocs
/ICONOCRACIA — *.pdf
