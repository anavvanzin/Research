# ~/Research/ is a meta-workspace, not a monorepo.
# Sub-repos (hub/, apps/*, pipelines/*, labs/*) have their own .git and
# MUST NOT be nested-tracked here. This repo only versions workspace-level
# meta files: README, CLAUDE.md, docs/.

# --- Ignore every bucket entirely ---
/hub/
/apps/
/pipelines/
/labs/
/vaults/
/shared/
/archive/

# --- Untracked research material (PDFs, admin docs, legacy outputs) ---
/Books/
/Cotutela/
/rotinas/
/dashboard.html

# --- Also ignore typical noise ---
.DS_Store
*.swp
*.swo
.remember/
**/.DS_Store
**/node_modules/
**/__pycache__/
**/.venv/
**/*.pyc
**/.pytest_cache/
**/*.log

# Repo-local self-improving-agent runtime state
/.claude/self-improving-agent/memory/episodic/**/*.json
/.claude/self-improving-agent/memory/working/*.json
!/.claude/self-improving-agent/memory/episodic/.gitkeep
!/.claude/self-improving-agent/memory/working/.gitkeep

# Session dumps (Hermes conversation exports)
/hermes_conversation_*.json
**/hermes_conversation_*.json
/hermes-agent/

# Git worktrees
/.worktrees/
/.claude/worktrees/
/Research/
.claude/settings.json

# --- Untracked sub-repos at root (own .git, not part of meta-workspace) ---
/agency-agents/
/agent-personal/
/agent-thesis/
/alignment-for-honesty/
/deep-memory/
/hermes-agent-camel/
/hermes-agent-*.bak-*/
/hermes-workspace/
/ml-intern/
/openclaw/
/united-by-marriage/
/cowork/

# --- Untracked symlinks to bucket sub-repos (resolved via /apps/, /hub/) ---
/iconocracia-companion
/iconocracy-corpus

# --- Top-level note/working dirs (intentionally local, not for git) ---
/Code/
/Do/
/Iconocracia/
/Ideas/
/Imported/
/LLM Skills/
/Other/
/Paths/
/Plans/
/Specs/
/Text/
/Tools/

# --- Stray root files ---
/Symlink - com~apple~CloudDocs
/ICONOCRACIA — *.pdf

